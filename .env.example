# Optional. Leave empty to run in fixture mode (pre-extracted sample data, no Claude calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Connection string. docker compose overrides it to point at the postgres service.
DATABASE_URL=postgres://ap:ap@localhost:5432/ap?sslmode=disable

API_PORT=3000
PAYMENT_MOCK_PORT=4000
PAYMENT_MOCK_URL=http://localhost:4000

# Extraction: per-call timeout and maximum upload size.
EXTRACT_TIMEOUT_MS=60000
EXTRACT_MAX_FILE_MB=10
GEOCODER_TIMEOUT_MS=2000

# Postgres session limits for the API pool. Must satisfy lock < statement < idle.
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_IDLE_IN_TX_TIMEOUT_MS=30000

# Matching tolerances: basis points (200 = 2%) and kilometres.
PRICE_TOLERANCE_BPS=200
ORIGIN_TOLERANCE_KM=100
AUTO_APPROVE_CLEAN=true

# The buyer that pays the invoices.
BUYER_NAME=Andes Retail S.A.S.
BUYER_COUNTRY=CO
BUYER_BASE_CURRENCY=COP

# Background jobs.
EXECUTE_INTERVAL_MS=5000
RECONCILE_INTERVAL_MS=10000
LEASE_SECONDS=30

# Directory holding the sample PDFs and their .expected.json files.
SAMPLES_DIR=samples
